{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@pc-proof/*": ["./apps/pc-proof/src/*"],
      "@tenu/db": ["./packages/db/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "apps/pc-proof/src/types/**/*.d.ts",
    "apps/pc-proof/src/main/**/*.ts",
    "apps/pc-proof/src/shared/**/*.ts",
    "packages/db/src/**/*.ts",
    "packages/db/src/**/*.d.ts"
  ]
}
