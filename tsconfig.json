{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@pc-proof/*": ["./apps/pc-proof/src/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
